<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>マイ・レシピノート（OneDrive Excel連携版）</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Noto Sans JP) -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: #f8fafc;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
    <!-- Microsoft認証ライブラリ (MSAL) -->
    <script src="https://alcdn.msauth.net/browser/3.24.0/js/msal-browser.min.js"></script>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-amber-600 text-white shadow-md sticky top-0 z-30">
        <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-white text-amber-600 p-2.5 rounded-xl shadow-inner">
                    <i class="fa-solid fa-utensils text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wide">マイ・レシピノート</h1>
                    <p class="text-xs text-amber-100">OneDrive Excel直接保存・AI解析版</p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto justify-end flex-wrap">
                <button onclick="openRecipeModal()" class="bg-white text-amber-700 hover:bg-amber-50 px-4 py-2 rounded-xl font-medium shadow-sm transition flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-plus"></i> 新規レシピ追加
                </button>
                <button onclick="openAiModal()" class="bg-amber-800 text-white hover:bg-amber-900 px-4 py-2 rounded-xl font-medium shadow-sm transition flex items-center gap-2 text-sm border border-amber-500/40">
                    <i class="fa-solid fa-camera-retro"></i> 写真からAI作成
                </button>
                <button onclick="loadRecipesFromSheets()" class="bg-amber-700 hover:bg-amber-800 text-white p-2.5 rounded-xl transition shadow-sm" title="OneDriveのExcelから再読み込み">
                    <i class="fa-solid fa-rotate"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto px-4 py-6 flex-grow w-full">
        <!-- Search & Filter Bar -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-6">
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                <!-- Keyword search -->
                <div class="sm:col-span-4 relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400"></i>
                    <input type="text" id="searchInput" placeholder="料理名や材料名で検索..." oninput="filterRecipes()" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                </div>
                <!-- Genre filter -->
                <div class="sm:col-span-3">
                    <select id="genreFilter" onchange="filterRecipes()" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                        <option value="">すべてのジャンル</option>
                    </select>
                </div>
                <!-- Supplier / Client filter -->
                <div class="sm:col-span-4">
                    <select id="supplierFilter" onchange="filterRecipes()" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                        <option value="">すべての取引先</option>
                    </select>
                </div>
                <!-- Reset button -->
                <div class="sm:col-span-1 flex items-center">
                    <button onclick="resetFilters()" title="フィルターをリセット" class="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl transition text-sm flex items-center justify-center">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Recipe Grid / List -->
        <div id="recipeContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Dynamically populated recipes -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-16 px-4">
            <div class="inline-flex bg-amber-50 text-amber-600 p-4 rounded-full text-3xl mb-3 shadow-inner">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-700">レシピがありません</h3>
            <p class="text-sm text-slate-500 mt-1 max-w-sm mx-auto">OneDriveのExcelからデータを読み込むか、新しくレシピを追加してみましょう！</p>
            <div class="mt-4 flex justify-center gap-3">
                <button onclick="openRecipeModal()" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2.5 rounded-xl font-medium text-sm shadow transition">
                    手動で追加する
                </button>
                <button onclick="loadRecipesFromSheets()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-medium text-sm shadow transition">
                    OneDriveのExcelから読み込み
                </button>
            </div>
        </div>
    </main>

    <!-- AI Photo Analysis Modal -->
    <div id="aiModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-amber-50/50">
                <h3 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> 写真からレシピを自動推測
                </h3>
                <button onclick="closeAiModal()" class="text-slate-400 hover:text-slate-600 p-2 rounded-lg hover:bg-slate-100 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 space-y-5">
                <p class="text-xs text-slate-500 leading-relaxed">
                    料理の写真や完成品の画像、または料理本やメモのスクリーンショットをアップロードすると、Gemini AIが料理名、ジャンル、メイン食材、材料、作り方を分析してフォームに自動入力します！
                </p>

                <!-- Dropzone / File Picker -->
                <div class="border-2 border-dashed border-slate-200 hover:border-amber-400 rounded-2xl p-6 text-center cursor-pointer transition bg-slate-50/50 relative" onclick="document.getElementById('aiImageInput').click()">
                    <input type="file" id="aiImageInput" accept="image/*" class="hidden" onchange="previewAiImage(event)">
                    <div id="aiUploadPlaceholder">
                        <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center mx-auto mb-3 text-xl shadow-inner">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <p class="text-sm font-medium text-slate-700">クリックして画像を選択、またはドラッグ＆ドロップ</p>
                        <p class="text-xs text-slate-400 mt-1">PNG, JPG, WEBP対応</p>
                    </div>
                    <div id="aiPreviewContainer" class="hidden">
                        <img id="aiImagePreview" src="" alt="Preview" class="max-h-48 mx-auto rounded-xl shadow-sm mb-2 object-cover">
                        <p class="text-xs text-amber-700 font-medium">画像を選択中（クリックで変更）</p>
                    </div>
                </div>

                <!-- Analysis Status / Loader -->
                <div id="aiLoading" class="hidden text-center py-4">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-amber-600 border-t-transparent mb-2"></div>
                    <p class="text-sm font-medium text-slate-600">Gemini AIが料理を分析中...</p>
                </div>

                <!-- Actions -->
                <div class="pt-2 flex justify-end gap-3">
                    <button type="button" onclick="closeAiModal()" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        キャンセル
                    </button>
                    <button type="button" id="analyzeBtn" onclick="analyzeRecipePhoto()" disabled class="bg-amber-600 hover:bg-amber-700 disabled:bg-slate-200 disabled:text-slate-400 text-white px-6 py-2.5 rounded-xl text-sm font-medium shadow-md transition flex items-center gap-2">
                        <i class="fa-solid fa-brain"></i> AI解析を実行する
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- Recipe Modal (Create / Edit) -->
    <div id="recipeModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in duration-200">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 id="modalTitle" class="font-bold text-lg text-slate-800">新規レシピの登録</h3>
                <button onclick="closeRecipeModal()" class="text-slate-400 hover:text-slate-600 p-2 rounded-lg hover:bg-slate-100 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <!-- Modal Body (Form) -->
            <div class="p-6 overflow-y-auto space-y-5 flex-grow">
                <form id="recipeForm" onsubmit="saveRecipe(event)">
                    <input type="hidden" id="recipeId">

                    <!-- Recipe Photo / Illustration Upload -->
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">料理の写真・イラスト</label>
                        <div class="flex items-center gap-4">
                            <div class="w-24 h-24 bg-slate-100 border-2 border-dashed border-slate-300 rounded-2xl flex items-center justify-center overflow-hidden relative group cursor-pointer hover:border-amber-500 transition" onclick="document.getElementById('recipeImageInput').click()">
                                <img id="recipeImagePreview" src="" alt="Preview" class="w-full h-full object-cover hidden">
                                <div id="recipeImagePlaceholder" class="text-center p-2 text-slate-400">
                                    <i class="fa-solid fa-image text-2xl mb-1"></i>
                                    <p class="text-[10px]">選択</p>
                                </div>
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs font-medium">
                                    変更
                                </div>
                            </div>
                            <div class="flex-grow space-y-2">
                                <input type="file" id="recipeImageInput" accept="image/*" class="hidden" onchange="previewRecipeImage(event)">
                                <div class="flex gap-2">
                                    <button type="button" onclick="document.getElementById('recipeImageInput').click()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-xl text-xs font-medium transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-upload"></i> 画像を選ぶ
                                    </button>
                                    <button type="button" id="removeImageBtn" onclick="clearRecipeImage()" class="hidden text-rose-600 hover:text-rose-700 px-3 py-1.5 rounded-xl text-xs font-medium transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-trash"></i> 削除
                                    </button>
                                </div>
                                <p class="text-[11px] text-slate-400">完成した料理の写真や手描きのイラスト画像をアップロードできます。</p>
                            </div>
                        </div>
                    </div>

                    <!-- Recipe Name -->
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">料理名 <span class="text-rose-500">*</span></label>
                        <input type="text" id="recipeName" required placeholder="例：特製スパイスバターチキンカレー" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                    </div>

                    <!-- Categories Row (Genre, Supplier, Main Ingredient) -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">分類（ジャンル）</label>
                            <input type="text" id="recipeGenre" list="genreList" placeholder="例：和食、中華..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                            <datalist id="genreList">
                                <option value="和食">
                                <option value="中華料理">
                                <option value="イタリアン">
                                <option value="インド料理">
                                <option value="エスニック">
                                <option value="洋食">
                                <option value="韓国料理">
                                <option value="その他">
                            </datalist>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">取引先 <span class="text-[10px] text-amber-600 font-normal">(手入力)</span></label>
                            <input type="text" id="recipeSupplier" list="supplierList" placeholder="例：〇〇商店..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                            <datalist id="supplierList"></datalist>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">メイン食材</label>
                            <input type="text" id="recipeMainIngredient" list="ingredientList" placeholder="例：鶏肉、豚肉..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                            <datalist id="ingredientList">
                                <option value="鶏肉">
                                <option value="豚肉">
                                <option value="牛肉">
                                <option value="魚介類">
                                <option value="野菜・豆腐">
                                <option value="その他">
                            </datalist>
                        </div>
                    </div>

                    <!-- Servings -->
                    <div class="mt-4">
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">分量（人数）</label>
                        <select id="recipeServings" class="w-full sm:w-1/2 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                            <option value="1人分">1人分</option>
                            <option value="2人分" selected>2人分</option>
                            <option value="3人分">3人分</option>
                            <option value="4人分">4人分</option>
                            <option value="5人分以上">5人分以上</option>
                            <option value="作りやすい分量">作りやすい分量</option>
                        </select>
                    </div>

                    <!-- Ingredients Section -->
                    <div class="mt-6">
                        <div class="flex justify-between items-center mb-2">
                            <div>
                                <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider">材料・分量・原価計算</label>
                                <p class="text-[11px] text-slate-400">材料名、分量、原価を入力すると自動で小計が計算されます</p>
                            </div>
                            <button type="button" onclick="addIngredientRow()" class="text-xs text-amber-600 hover:text-amber-700 font-bold flex items-center gap-1 bg-amber-50 px-2.5 py-1.5 rounded-lg transition shrink-0">
                                <i class="fa-solid fa-plus"></i> 材料を追加
                            </button>
                        </div>

                        <!-- Header guide for rows -->
                        <div class="hidden sm:grid grid-cols-12 gap-2 text-[11px] font-bold text-slate-400 px-1 mb-1">
                            <div class="col-span-4">材料名</div>
                            <div class="col-span-2">分量 (数値)</div>
                            <div class="col-span-2">単位</div>
                            <div class="col-span-2">材料原価(円)</div>
                            <div class="col-span-1 text-right">小計</div>
                            <div class="col-span-1"></div>
                        </div>

                        <div id="ingredientsContainer" class="space-y-2">
                            <!-- Dynamic rows -->
                        </div>

                        <!-- Total Cost & Pricing Summary inside Modal -->
                        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="bg-amber-50/70 border border-amber-200/60 rounded-xl p-3 flex justify-between items-center">
                                <span class="text-xs font-bold text-amber-900 flex items-center gap-1.5">
                                    <i class="fa-solid fa-calculator text-amber-600"></i> 合計原価
                                </span>
                                <span id="formTotalCostDisplay" class="text-base font-bold text-amber-800">¥0</span>
                            </div>
                            <div class="bg-emerald-50/70 border border-emerald-200/60 rounded-xl p-3 flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-emerald-900 flex items-center gap-1.5">
                                        <i class="fa-solid fa-yen-sign text-emerald-600"></i> 目標利益率
                                    </span>
                                    <select id="recipeProfitMargin" onchange="calculateFormTotalCost()" class="px-2 py-1 bg-white border border-emerald-200 rounded-lg text-xs font-bold text-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                        <option value="10">10%</option>
                                        <option value="20">20%</option>
                                        <option value="30" selected>30%</option>
                                        <option value="40">40%</option>
                                        <option value="50">50%</option>
                                        <option value="60">60%</option>
                                        <option value="70">70%</option>
                                    </select>
                                </div>
                                <div class="text-right">
                                    <p class="text-[10px] text-emerald-700 uppercase font-bold">推奨売価</p>
                                    <span id="formSellingPriceDisplay" class="text-base font-extrabold text-emerald-800">¥0</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notes / Comments Section -->
                    <div class="mt-6">
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">コメント・メモ欄（手順・コツなど）</label>
                        <textarea id="recipeNotes" rows="5" placeholder="1. 鶏肉を一口大に切る&#10;2. スパイスを炒めて香りを立たせる..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition"></textarea>
                    </div>

                    <!-- Form Actions -->
                    <div class="mt-8 pt-4 border-t border-slate-100 flex justify-end gap-3">
                        <button type="button" onclick="closeRecipeModal()" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                            キャンセル
                        </button>
                        <button type="submit" id="saveRecipeBtn" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-2.5 rounded-xl text-sm font-medium shadow-md transition flex items-center gap-2">
                            <i class="fa-solid fa-check"></i> OneDriveのExcelに保存
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Recipe Detail Modal -->
    <div id="detailModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in duration-200">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <div class="flex items-center gap-2 flex-wrap">
                    <span id="detailGenre" class="bg-amber-100 text-amber-800 text-xs px-2.5 py-1 rounded-full font-medium"></span>
                    <span id="detailSupplier" class="bg-sky-100 text-sky-800 text-xs px-2.5 py-1 rounded-full font-medium"></span>
                    <span id="detailMainIngredient" class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-full font-medium"></span>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="editCurrentRecipe()" class="text-slate-500 hover:text-amber-600 p-2 rounded-lg hover:bg-white transition" title="編集">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </button>
                    <button onclick="deleteCurrentRecipe()" class="text-slate-500 hover:text-rose-600 p-2 rounded-lg hover:bg-white transition" title="削除">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                    <button onclick="closeDetailModal()" class="text-slate-400 hover:text-slate-600 p-2 rounded-lg hover:bg-white transition">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
            </div>
            <!-- Body -->
            <div class="p-6 overflow-y-auto space-y-6 flex-grow">
                <!-- Recipe Detail Image -->
                <div id="detailImageContainer" class="hidden w-full h-48 sm:h-64 rounded-2xl overflow-hidden bg-slate-100 shadow-inner">
                    <img id="detailImage" src="" alt="Recipe Image" class="w-full h-full object-cover">
                </div>

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h2 id="detailTitle" class="text-2xl font-bold text-slate-800 mb-2"></h2>
                        <div class="flex items-center gap-2 text-slate-500 text-sm">
                            <i class="fa-solid fa-user-group text-amber-600"></i>
                            <span id="detailServings"></span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <div class="bg-amber-50 border border-amber-200 px-4 py-2 rounded-2xl text-right flex-1 sm:flex-initial">
                            <p class="text-[10px] uppercase font-bold text-amber-800 tracking-wider">合計原価</p>
                            <p id="detailTotalCost" class="text-base font-extrabold text-amber-700">¥0</p>
                        </div>
                        <div class="bg-emerald-50 border border-emerald-200 px-4 py-2 rounded-2xl text-right flex-1 sm:flex-initial">
                            <p id="detailProfitLabel" class="text-[10px] uppercase font-bold text-emerald-800 tracking-wider">推奨売価</p>
                            <p id="detailSellingPrice" class="text-base font-extrabold text-emerald-700">¥0</p>
                        </div>
                    </div>
                </div>

                <!-- Ingredients Table -->
                <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100">
